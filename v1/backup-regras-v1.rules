rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isMaster() {
      return request.auth != null
        && request.auth.token.email == "gw.vidal@gmail.com";
    }

    function isDemoEvent(eventId) {
      return eventId == "evento-demo";
    }

    function eventExists(eventId) {
      return exists(/databases/$(database)/documents/events/$(eventId));
    }

    match /eventAccess/{eventId} {
      allow read, write: if isMaster();
    }

    match /coupons/{couponCode} {
      allow read, write: if isMaster();
    }

    match /events/{eventId} {
      allow read: if isMaster()
        || eventExists(eventId)
        || isDemoEvent(eventId);

      allow create: if isMaster()
        || isDemoEvent(eventId);

      allow update: if isMaster()
        || eventExists(eventId)
        || isDemoEvent(eventId);

      allow delete: if isMaster();

      match /guests/{guestId} {
        allow read: if isMaster()
          || eventExists(eventId)
          || isDemoEvent(eventId);

        allow create, update, delete: if isMaster()
          || eventExists(eventId)
          || isDemoEvent(eventId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}